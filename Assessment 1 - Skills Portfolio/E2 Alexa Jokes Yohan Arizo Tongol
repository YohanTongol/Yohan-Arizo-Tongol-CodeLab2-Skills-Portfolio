def jokelist(): #Creates a function which then creates a list of all jokes from your file location using os
    alexajokes=[]
    folderpath=os.path.dirname(os.path.abspath(__file__)) #Suggestion from Gemini to find file location through computer instead
    filelocation = os.path.join(folderpath,"randomJokes.txt") #Combines file and folder for a path through the os

    with open(filelocation,"r", encoding="utf-8") as joker: #utf-8 is used here to enable the computer to read dashes
        for line in joker:
            fix=line.strip() #Removes trailing and leading letters
            if "?" in fix: #checks if there is a question mark in the file to seperate jokes from punchlines
                setup,punchline=fix.split("?",1)
                alexajokes.append((setup.strip()+"?",punchline.strip()))
    return alexajokes

jokes = jokelist()
j =""
p =""

#display jokes, punchline and buttons here
def jokedisplay(): #holds variables with the random jokes to display and resets punchline
    global j, p
    j,p=random.choice(jokes)
