punchlineloc=Label(root,text="",fg=("BLack"),bg=("#F5F3EB"),font=("Tahoma",12,'bold'))

jokeb=Button(root,text="Alexa tell me a joke",width=15,height=2,command=jokedisplay)

punchlineb=Button(root,text="Punchline",width=15,height=2,command=punchlinedisplay)

nextb=Button(root,text="Next Joke Alexa!",command=nextjoke)

jokeloc.place(x=70,y=120)
l1.place(x=130,y=50)
