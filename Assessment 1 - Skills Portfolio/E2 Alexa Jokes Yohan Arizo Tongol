from tkinter import *
import os
import random
import tkinter as tk
root =Tk()
root.title("Alexa Jokes")
root.geometry("600x400")
root.config(bg="#F5F3EB")

border=Frame(root, bg="#234567")
border.place(x=0,y=100,width=600,height=4)

#Progress 3

def jokelist():
    alexajokes=[]
    folderpath=os.path.dirname(os.path.abspath(__file__)) #Suggestion from Gemini to find file location through computer instead
    filelocation = os.path.join(folderpath,"randomJokes.txt")

    with open(filelocation,"r", encoding="utf-8") as joker: #utf-8 is used here to enable the computer to read dashes
        for line in joker:
            fix=line.strip()
            if "?" in fix: #checks if there is a question mark in the file to seperate jokes from punchlines
                setup,punchline=fix.split("?",1)
                alexajokes.append((setup.strip()+"?",punchline.strip()))
    return alexajokes

jokes = jokelist()
j =""
p =""

#display jokes, punchline and buttons here
def jokedisplay(): #holds variables with the random jokes to display and resets punchline
    global j, p
    j,p=random.choice(jokes)
    jokeloc.config(text=j)
    punchlineloc.config(text="")
   

def punchlinedisplay():#button for displaying punchline
    punchlineloc.config(text=p)

def nextjoke():#displays next joke and resets punchline
    punchlineloc.config(text="")
    punchlineb.place_forget()
    jokedisplay()




#all labels and displays here
l1=Label(root,text="Alexa, Tell me a Joke!",fg=("#43BBEB"),bg=("#F5F3EB"),font=("Tahoma",24,'bold'))
