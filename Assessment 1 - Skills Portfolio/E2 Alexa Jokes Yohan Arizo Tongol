def jokelist():
    alexajokes=[]
    folderpath=os.path.dirname(os.path.abspath(__file__)) #Suggestion from Gemini to find file location through computer instead
    filelocation = os.path.join(folderpath,"randomJokes.txt")

    with open(filelocation,"r", encoding="utf-8") as joker: #utf-8 is used here to enable the computer to read dashes
        for line in joker:
            fix=line.strip()
            if "?" in fix:
                setup,punchline=line("?",1)
                alexajokes.append(setup.strip()+"?",punchline.strip())  
    return alexajokes

