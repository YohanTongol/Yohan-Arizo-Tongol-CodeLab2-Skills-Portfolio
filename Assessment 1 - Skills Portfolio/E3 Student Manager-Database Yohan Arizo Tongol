from tkinter import *
import tkinter as tk
root =Tk()
root.title("Student Manager/Database")
root.geometry("600x600")
root.config(bg="#F3EBC2")

#Progress 3

l1=Label(root,text="Students Database",font=("Tahoma",24),bg="#F3EBC2")
info=Label(root,text="Information Goes Here")
border=Frame(root, bg="black",width=600,height=4)
feedback=Label(root,text="info")

border.place(x=0,y=350)
info.place(x=330,y=130)
l1.place(x=170,y=50)


def textfile(filename="studentMarks.txt"):#function to open textfile from computer to store in a dictionary
    students={}
    with open(filename,"r") as file: #txt file to dictionary was suggested by Gemini AI
        for line in file:
            line=line.strip()
            if not line:
                continue
            parts = line.split(",")
            stid=int(parts[0])
            name=parts[1]
            marks=[int(parts[2]), int(parts[3]), int(parts[4])]
            total=int(parts[5])
            students[stid]={"name": name, "marks":marks,"total":total}
    return students
students = textfile()

def viewallfunc(): #The function responsible for viewing all student records
    list=[] #A list to store/display student records
    for stid,data in students.items():#for loop to go over all students
        marksstr=", ".join(str(m) for m in data["marks"])
        list.append(f"{stid} - {data["name"]} |  Marks: [{marksstr}] |  Total: {data["total"]}") #Appends all the student data in the list
    info.config(text="\n".join(list),font=("Tahoma",10))#Creates a break which then joins to the list to display vertically
    info.place(x=240)


def indivfunc():#This function is responsible for looking up students using their ids and Entry box
    userinput=userentry.get().strip()
    if not userinput.isdigit():#if user input is not a digit string, it will configure a label to notify the user
        feedback.config(text="Please Enter A Student Number ID")
        return

    stid=int(userinput)
    if stid not in students:#If the userinput is not in the students dictionary, it will configure the label once again
        feedback.config(text="Student Not Found, Enter a different ID")
        return
      
    data = students[stid]
    info.config(text=f"ID: {stid}\n name:{data["name"]}\n ")#Displays the student based on the ID entered

def highest():
    hightotal=max(data["total"] for data in students.values()) #Finds the largest nnumber in the students dictionary based on the values
    honors= [f"{data["name"]} ({stid}) - {data["total"]}"#creates the structure to display
             for stid, data in students.items()
             if data["total"] == hightotal]#loops and finds the highest total of a student to display
    info.config(text="Student with the Highest Total Score:\n".join(honors))

def lowest():
    lowtotal=min(data["total"] for data in students.values())
    lowscorer=[f"{data["name"]} ({stid}) - {data["total"]}"
            for stid, data in students.items()
            if data["total"] == lowtotal]#this loops and finds the lowest total of a student instead
    info.config(text="Student with the Lowest Total Score:\n".join(lowscorer))
            


#All Buttons and Labels here
viewall=Button(root,text="All Student Records",width=25,command=viewallfunc)

viewindv=Button(root,text="Individual Student Records",width=25,command=indivfunc)
userentry=Entry(root,font=(24))

shigh=Button(root,text="Student With Highest Total Score",width=25,command=highest)
slow=Button(root,text="Student With Lowest Total Score",width=25,command=lowest)

userentry.place(x=300,y=400)
feedback.place(x=300,y=500)
viewall.place(x=10,y=120)
viewindv.place(x=10,y=450)#160
shigh.place(x=10,y=200)
slow.place(x=10,y=240)




root.mainloop()
