def textfile(filename="studentMarks.txt"):#function to open textfile from computer to store in a dictionary
    students={}
    with open(filename,"r") as file: #txt file to dictionary was suggested by Gemini AI
        next(file)
        for line in file:
            line=line.strip()
            if not line:
                continue #This skips empty lines
            parts = line.split(",")
            stid=int(parts[0])
            name=parts[1]
            marks=[int(parts[2]), int(parts[3]), int(parts[4])]
            total=int(parts[5])#Gives each variable a part in the line and splits them using ","
            students[stid]={"name": name, "marks":marks,"total":total}#Finalizes the dictionary
    return students
students = textfile()

def savefunc(filename="studentMarks.txt"):
    if not students: #prevents crashes
        return
    with open(filename,"w") as update:#opens the file and writes over it using "w"
        update.write(f"{len(students)}\n")
        for stid,data in students.items():
            marksstr=",".join(str(m) for m in data ["marks"]) #Gemini AI suggestion to split each  marks neatly using ",". Displays marks based on user input
            update.write(f"{stid},{data["name"]},{marksstr},{data["total"]}\n") #writes data within the dictionary upon calling the function
