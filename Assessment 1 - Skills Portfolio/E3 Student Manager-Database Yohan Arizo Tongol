def viewallfunc(): #The function responsible for viewing all student records
    list=[] #A list to store/display student records
    for stid,data in students.items():#for loop to go over all students
        marksstr=", ".join(str(m) for m in data["marks"])
        list.append(f"{stid} - {data["name"]} |  Marks: [{marksstr}] |  Total: {data["total"]}") #Appends all the student data in the list
    info.config(text="\n".join(list),font=("Tahoma",11),bg="white")#Creates a break which then joins to the list to display vertically
    info.place(x=200,y=120)


def indivfunc():#This function is responsible for looking up students using their ids and Entry box
    userinput=userentry.get().strip()
    if not userinput.isdigit():#if user input is not a digit string, it will configure a label to notify the user
        feedback.config(text="Please Enter A Student Number ID")
        return

    stid=int(userinput)
    if stid not in students:#If the userinput is not in the students dictionary, it will configure the label once again
        feedback.config(text="Student Not Found, Enter a different ID")
        return
      
    data = students[stid]
    info.config(text=f"ID: {stid}\n Name:{data["name"]}\nMarks: {data["marks"]}\n Total:{data["total"]} ",
                bg="white",font=(24))#Displays the student based on the ID entered
    info.place(x=350,y=150)

def highest():
    hightotal=max(data["total"] for data in students.values()) #Finds the largest nnumber in the students dictionary based on the values
    honors= [f"{data["name"]} ({stid}) - {data["total"]}"#creates the structure to display
             for stid, data in students.items()
             if data["total"] == hightotal]#loops and finds the highest total of a student to display
    info.config(text="Student with the Highest Total Score:\n".join(honors),bg="white",font=(24))
    info.place(x=350,y=150)

def lowest():
    lowtotal=min(data["total"] for data in students.values())
    lowscorer=[f"{data["name"]} ({stid}) - {data["total"]}"
            for stid, data in students.items()
            if data["total"] == lowtotal]#this loops and finds the lowest total of a student instead
    info.config(text="Student with the Lowest Total Score:\n".join(lowscorer),bg="white",font=(24))
    info.place(x=350,y=150)

def dscfunc():# Function responsible for sorting descending order with the use of sorted and student items
    declist=sorted(students.items(), key=lambda x: x[1]["total"])
    list=[]
    for stid, data in declist:#Creates a list and variables to store into the list
        marksstr =",".join(str(m) for m in data["marks"])#marksstr joins the marks in the dictionary into once variable
        list.append(f"{stid} - {data["name"]} | Marks: [{marksstr}] | Total: {data["total"]}")
    info.config(text="\n".join(list),font=("Tahoma",10))
    info.place(x=240)
                
def ascfunc():#Function responsible for ascending sorting, utilizes reverse=True to reverse the sorted syntax
    asclist=sorted(students.items(), key=lambda x: x[1]["total"],reverse=True) 
    list=[]
    for stid, data in asclist:
        marksstr =",".join(str(m) for m in data["marks"])
        list.append(f"{stid} - {data["name"]} | Marks: [{marksstr}] | Total: {data["total"]}")
    info.config(text="\n".join(list),font=("Tahoma",10))
    info.place(x=240)

def addstudent():
    userinput=userentry1.get().strip()
    if not userinput.isdigit():#checks if the userinput is a digit 
        feedback.config(text="Please Enter a Student ID")
        return
    
    stid=int(userinput)
    if stid in students:
        feedback.config(text="Student ID Already Exists.")
        return

    sname=userentry2.get().strip() #collects user entries to store in a variable
    marks=userentry3.get().strip().split(",")
    orgmarks=[int(m.strip()) for m in marks if m.strip().isdigit()]

    if not sname or not orgmarks:
        feedback.config(text="Enter a name and proper 3 proper marks")
        return
    students[stid] = {"name":sname, "marks":marks,"total": sum(orgmarks)}
    savefunc()
    feedback.config(text=f"Student {sname} has been added.")
    viewallfunc

def updstudent():
    userinput=userentry1.get().strip()
    if not userinput.isdigit() or int(userinput) not in students:
     feedback.config(text="Enter an existing ID")
     return

    stid=int(userinput)
    sname=userentry2.get().strip()
    marks=userentry3.get().strip()

    if sname:
        students[stid]["name"] = sname
    if marks:
        orgmarks=[int(m.strip()) for m in marks.split(",") if m.strip().isdigit()]
        if orgmarks:
            students[stid]["marks"] = orgmarks
            students[stid]["total"] = sum(orgmarks)
    savefunc()
    feedback.config(text=f"Student Information has been Updated")



def delstudent():
    userinput = userentry1.get().strip()
    if not userinput.isdigit() or int(userinput) not in students:
        feedback.config(text="Enter an Existing ID for Deletion")
        return
    stid=int(userinput)
    del students[stid]
    savefunc()
    feedback.config(text="Student Has Been Deleted")
   
            


