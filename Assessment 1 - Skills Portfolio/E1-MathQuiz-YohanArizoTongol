def displayProblem(): #Randomizes number depending on difficulty 
  global n1, n2, correct, nm1, nm2, mcorrect, nh1, nh2, hcorrect
  decideOperation()

  n1=random.randint(1,9)
  n2=random.randint(1,9)
  correct= n1 + n2 if operation =='+' else n1 - n2

  nm1=random.randint(10,99)
  nm2=random.randint(10,99)
  mcorrect = nm1 + nm2 if operation == '+' else nm1-nm2

  nh1=random.randint(100,999)
  nh2=random.randint(100,999)
  hcorrect = nh1 + nh2 if operation == '+' else nh1-nh2

def decideOperation():
 global operation
 operation = random.choice(['+','-'])


def displayResults():
  useranswer.place_forget()
  submit.place_forget()

  if score >=95:
   grade = "Grade: A+"
  elif score >=85:
   grade = "Grade: A"
  elif score >=75 :
   grade = "Grade: C"
  elif score>=65:
   grade = "Grade: D"
  else:
   grade=" Grade: F (You Can Always Try Again!)"

  messagebox.showinfo("Quiz Grade",f"Final Score: {score}/100\n {grade}")
  

def submitbutton(useranswer,feedback):
 global score, tries
 difficultyanswer = correct if difficultymode == "easy" else (mcorrect if difficultymode == "medium" else hcorrect)
 try:
  answer = int(useranswer.get())
  if answer == difficultyanswer:
   if tries == 0:
    feedback.config(text="Answer is Correct!",fg="green")
    score += 10
   else:
    score +=5
    feedback.config(text="Second Chance Answer is Correct!",fg="#97A709")
   nextQuestion()

  else:
   tries += 1
   if tries < 2:
    feedback.config(text="Wrong answer Try again.",fg="black")
    useranswer.delete(0,END)
   else:
    feedback.config(text="Wrong Answer, Out of Tries. Next Question")
    nextQuestion()
   
 except ValueError:
  feedback.config(text="Please enter your valid number")

def nextQuestion():
 global questionc, tries
 scoreholder.config(text=f"Score:{score}/100")
 if questionc>=10:
   displayResults()
   return
 
 questionc += 1
 tries = 0
 useranswer.delete(0,END)
 displayProblem()

 if difficultymode =="easy":
  question.config(text=f"{questionc}. {n1} {operation} {n2}")
 elif difficultymode == "medium":
  question.config(text=f"{questionc}. {nm1} {operation} {nm2}")
 else:
  question.config(text=f"{questionc}. {nh1} {operation} {nh2}")

displayMenu()
menu()
decideOperation()
displayProblem()

root.mainloop()
