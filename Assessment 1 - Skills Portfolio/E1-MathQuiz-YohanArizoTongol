def displayProblem(): #Randomizes number depending on difficulty 
  global n1, n2, correct, nm1, nm2, mcorrect, nh1, nh2, hcorrect
  decideOperation() #Calls decide operation to decide either to use addition or subctraction user random number generator

  n1=random.randint(1,9)
  n2=random.randint(1,9)
  correct= n1 + n2 if operation =='+' else n1 - n2 #Decides the the correct answer for easy. randomizes numbers from 1 to 9

  nm1=random.randint(10,99)
  nm2=random.randint(10,99)
  mcorrect = nm1 + nm2 if operation == '+' else nm1-nm2 #Decides the answer for medium. randomizes numbers from 10 to 99

  nh1=random.randint(1000,9999)
  nh2=random.randint(1000,9999)
  hcorrect = nh1 + nh2 if operation == '+' else nh1-nh2 #Decides the answer for hard and randomizes numbers from 1000 to 9999

def decideOperation():
 global operation
 operation = random.choice(['+','-']) #chooses the operation randomly with random.choice


def displayResults():#Displays the user results and grade after the 10th question
  useranswer.place_forget() #removes the submit and entry to stop quiz
  submit.place_forget()

  if score >=95: #If else statements to check user grade depending on their score
   grade = "Grade: A+"
  elif score >=90:
   grade = "Grade: A"
  elif score >=85 :
   grade = "Grade: B"
  elif score>=75:
   grade = "Grade: C"
  else:
   grade=" Grade: F (You Can Always Try Again!)"

  messagebox.showinfo("Quiz Grade",f"Final Score: {score}/100\n {grade}") #displays a messagebox with the users grade
  

def submitbutton(useranswer,feedback):#Function used on the submit button and takes user answer and display feedback as parameters
 global score, tries
 difficultyanswer = correct if difficultymode == "easy" else (mcorrect if difficultymode == "medium" else hcorrect)# This line has been suggested by Gemini AI on how to clean up variable decision
 try:#Try and except statement to ensure the user inputs integers
  answer = int(useranswer.get())
  if answer == difficultyanswer: #The following if else statements checks the user answer if they have answered in 1 try or not
   if tries == 0:
    feedback.config(text="Answer is Correct!",fg="green")
    score += 10 #Gives a +10 if the user answers first try and +5 if not
   else:
    score +=5
    feedback.config(text="Chance Answer is Correct!",fg="Green")
    feedback.place(x=256)
   nextQuestion()#displays next question right after

  else:
   tries += 1 #adds one try if the user gets the answer wrong one time
   if tries < 2:
    feedback.config(text="Wrong answer Try again.",fg="black")
    feedback.place(x=245)
    useranswer.delete(0,END)#.delete(0,END) ensures that the entry characters have been deleting from start to end
   else:
    feedback.config(text="Wrong Answer, Out of Tries. Next Question",)
    feedback.place(x=210)
    nextQuestion() #if the user reaches 2 tries, the nextQuestion function will run and display wrong answer. Awards the user no scores
   
 except ValueError:
  feedback.config(text="Please enter your valid number")#If anything but a number has been inputed this error will display

def nextQuestion():
 global questionc, tries
 useranswer.focus() #Suggestion from Gemini. Instantly focuses user typing to the textbox without having to manually press
 scoreholder.config(text=f"Score:{score}/100") #Upon going to the next question, this config will display the users score currently
 if questionc>=10:
   displayResults()#If the user has reached 10 questions their final score will display
   return
 
 questionc += 1
 tries = 0 #Every next question will add to the question counter and reset the tries
 useranswer.delete(0,END)
 displayProblem() # Deletes the user entry and displays next problem

 if difficultymode =="easy":
  question.config(text=f"{questionc}.  {n1} {operation} {n2}")
 elif difficultymode == "medium":
  question.config(text=f"{questionc}.  {nm1} {operation} {nm2}")
 else:
  question.config(text=f"{questionc}.  {nh1} {operation} {nh2}") #Displays question count and different random numbers depending on the difficulty

displayProblem()
displayMenu()
menu()
decideOperation()

